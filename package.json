{
  "name": "mochi-kitchen",
  "version": "1.0.0",
  "description": "Mochi Kitchen - an AI recipe finder with NLP search, TheMealDB, Gemini, favourites, grocery lists and a meal planner.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:down": "node src/db/migrate.js down",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "keywords": ["recipe", "nlp", "gemini", "express", "sequelize"],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "natural": "^8.2.6",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/db/migrate.js", "!src/db/seed.js"]
  }
}
