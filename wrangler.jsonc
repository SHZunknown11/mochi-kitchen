{
  // Mochi Kitchen on Cloudflare Workers (free plan). The Node/Express app in src/ is kept for local use.
  "name": "mochi-kitchen",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // The front end (public/) is served by Cloudflare's asset hosting; only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mochi-kitchen",
      "database_id": "84eb2f27-3ad8-4962-80cf-1709bdbfe30f",
      "migrations_dir": "worker/migrations"
    }
  ],

  // Cloudflare Rate Limiting bindings (per Cloudflare location, per key). Login/register use D1 counters.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "7101", "simple": { "limit": 120, "period": 60 } },
    { "name": "AI_LIMITER", "namespace_id": "7102", "simple": { "limit": 12, "period": 60 } }
  ],

  "vars": {
    "GEMINI_MODEL": "gemini-flash-lite-latest"
  },

  "observability": { "enabled": true }
}
