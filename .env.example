# Copy this file to ".env" and fill it in. ".env" is ignored by git - never commit it.

PORT=3000

# --- Database ---------------------------------------------------------------
# sqlite (default, no install needed) or mysql
DB_DIALECT=sqlite
DB_STORAGE=data/mochi.sqlite
# Only needed when DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mochi_kitchen
DB_USER=root
DB_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Long random strings. If you leave these empty, random ones are generated on
# every start (so everyone gets logged out when the server restarts).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Gemini (optional but recommended) --------------------------------------
# Create your OWN free key at https://aistudio.google.com/apikey and paste it here.
# Without a key the app still works: it falls back to the free recipe APIs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Optional extra provider ------------------------------------------------
# Spoonacular is only used if this is set (https://spoonacular.com/food-api).
SPOONACULAR_API_KEY=
